<?xml version="1.0" encoding="utf-8"?>
<!--
    Dialog konfirmasi Hapus Akun.
    Struktur ini menebak pola dari confirm_logout_dialog.xml (yang belum saya lihat
    isinya) - kalau gaya visual/margin/style aslinya berbeda, sesuaikan supaya
    konsisten dengan dialog logout yang sudah ada.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hapus_akun_konfirmasi_judul"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hapus_akun_konfirmasi_pesan"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_delete_confirmed"
        style="@style/CustomDangerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ya_hapus_akun"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_delete"
        style="@style/CustomOutlineButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textSize="18sp"
        android:textStyle="bold"/>

</LinearLayout>